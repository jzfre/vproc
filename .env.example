# Copy to .env in the directory where you run vproc. Existing environment
# variables take precedence. This file contains examples, not running servers.
# Replace EVERY endpoint/model placeholder with your actual backend settings.
# Base URLs include /v1, not /chat/completions, /embeddings, or /audio/transcriptions.
# The client uses the fixed API key "not-needed"; authenticated providers need
# a compatible proxy. localhost refers to the computer running vproc.

# Vision chat model: image input for OCR and speaker nameplates.
VPROC_OCR_BASE_URL=http://localhost:8000/v1
VPROC_OCR_MODEL=replace-with-your-vision-model
# Embedding server: required for ingestion and search. Keep model/weights stable
# for an existing index; a different embedding model requires a new index.
VPROC_EMBED_BASE_URL=http://localhost:1234/v1
VPROC_EMBED_MODEL=replace-with-your-embedding-model
# Chat model: structured JSON output for grounded answers.
VPROC_GROUNDING_BASE_URL=http://localhost:1234/v1
VPROC_GROUNDING_MODEL=replace-with-your-grounding-model

# ASR: empty BASE_URL selects local MLX Whisper on Apple Silicon macOS only.
# Windows/Linux MUST set the two values to an OpenAI-compatible ASR server,
# ideally returning verbose_json with timestamped segments. Example:
# VPROC_TRANSCRIBE_BASE_URL=http://localhost:8001/v1
# VPROC_TRANSCRIBE_MODEL=replace-with-your-asr-model
VPROC_TRANSCRIBE_BASE_URL=
VPROC_TRANSCRIBE_MODEL=mlx-community/whisper-large-v3-turbo

# Service is unauthenticated. 0.0.0.0 intentionally allows LAN access; restrict
# the port with your firewall. Set 127.0.0.1 for access only from this computer.
VPROC_HOST=0.0.0.0
VPROC_PORT=8765
# Relative paths resolve from the working directory. The index also stores
# absolute paths to original videos/screenshots; moving these needs re-ingest.
VPROC_INDEX_PATH=./vproc.lance
VPROC_FRAMES_DIR=./vproc_frames

# Optional diarization: install the diarization or runtime extra, accept the
# model conditions at https://huggingface.co/pyannote/speaker-diarization-community-1,
# and put HF_TOKEN in your private .env or environment. First use downloads weights.
# HF_TOKEN=your-private-hugging-face-token
# Set VPROC_DIARIZE_MODEL= to disable diarization and automatic speaker naming.
VPROC_DIARIZE_MODEL=pyannote/speaker-diarization-community-1
VPROC_SPEAKER_NAMING=on

# HHEM runs locally for answer verification (answer or runtime extra). First
# use can download weights and model code; only select a model repo you trust.
VPROC_HHEM_MODEL=vectara/hallucination_evaluation_model

# Tuning
VPROC_SIM_FLOOR=0.25
VPROC_HHEM_THRESHOLD=0.5
VPROC_OCR_TIMEOUT=60
VPROC_OCR_MAX_TOKENS=1024
VPROC_GROUNDING_MAX_TOKENS=8192
VPROC_GROUNDING_THINKING=on
