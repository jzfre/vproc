# AI endpoints (OpenAI-compatible). Copy to .env and adjust.
VPROC_OCR_BASE_URL=http://voyage:8000/v1
VPROC_OCR_MODEL=QuantTrio/Qwen3.5-9B-AWQ
VPROC_EMBED_BASE_URL=http://localhost:1234/v1
VPROC_EMBED_MODEL=Qwen3-Embedding-0.6B
VPROC_GROUNDING_BASE_URL=http://localhost:1234/v1
VPROC_GROUNDING_MODEL=Qwen3-32B-AWQ
# Transcription (ASR). Leave BASE_URL empty for local in-process whisper (mlx on Apple
# Silicon); set it to an OpenAI-compatible /v1/audio/transcriptions endpoint to run ASR
# on another host. Example endpoint mode:
#   VPROC_TRANSCRIBE_BASE_URL=http://voyage:8001/v1
#   VPROC_TRANSCRIBE_MODEL=Systran/faster-whisper-large-v3
VPROC_TRANSCRIBE_BASE_URL=
VPROC_TRANSCRIBE_MODEL=mlx-community/whisper-large-v3-turbo
# Service + storage
VPROC_HOST=0.0.0.0
VPROC_PORT=8765
VPROC_INDEX_PATH=./vproc.lance
# Tuning
VPROC_SIM_FLOOR=0.25
VPROC_HHEM_THRESHOLD=0.5
